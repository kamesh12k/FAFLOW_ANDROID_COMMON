{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "FAFLOW Design System Tokens",
  "version": "2.0.0",
  "description": "Unified design tokens shared between React Web (Tailwind CSS) and Android Mobile (Jetpack Compose).",
  "primitive": {
    "color": {
      "navy": {
        "50": "#EAF0F9",
        "100": "#D5E2F4",
        "200": "#ABC4E9",
        "300": "#81A6DE",
        "400": "#5788D3",
        "500": "#2E5490",
        "600": "#1B3A6B",
        "700": "#162E56",
        "800": "#102340",
        "900": "#0B172B"
      },
      "teal": {
        "50": "#E4F3F1",
        "100": "#C9E8E4",
        "200": "#94D1C9",
        "300": "#5FBAAE",
        "400": "#2AA393",
        "500": "#128C7E",
        "600": "#0E8074",
        "700": "#0B665D",
        "800": "#084C46",
        "900": "#05332F"
      },
      "violet": {
        "50": "#EFEBFC",
        "100": "#DFD7FA",
        "200": "#BFAFF5",
        "300": "#9F87F0",
        "400": "#7F5FEB",
        "500": "#6C4FCE",
        "600": "#5B42AE",
        "700": "#49358C",
        "800": "#37286B",
        "900": "#251B49"
      },
      "gold": {
        "50": "#FBF1DF",
        "100": "#F6E3BE",
        "200": "#EDC87D",
        "300": "#E3AC3C",
        "400": "#C4901C",
        "500": "#A6790A",
        "600": "#876208",
        "700": "#674B06",
        "800": "#483404",
        "900": "#281D02"
      },
      "slate": {
        "50": "#F8FAFC",
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "300": "#CBD5E1",
        "400": "#94A3B8",
        "500": "#64748B",
        "600": "#475569",
        "700": "#334155",
        "800": "#1E293B",
        "900": "#0F172A",
        "950": "#020617"
      },
      "emerald": {
        "50": "#ECFDF5",
        "100": "#D1FAE5",
        "200": "#A7F3D0",
        "300": "#6EE7B7",
        "400": "#34D399",
        "500": "#10B981",
        "600": "#059669",
        "700": "#047857",
        "800": "#065F46",
        "900": "#064E3B"
      },
      "rose": {
        "50": "#FFF1F2",
        "100": "#FFE4E6",
        "200": "#FECDD3",
        "300": "#FDA4AF",
        "400": "#FB7185",
        "500": "#F43F5E",
        "600": "#E11D48",
        "700": "#BE123C",
        "800": "#9F1239",
        "900": "#881337"
      }
    },
    "spacing": {
      "xxs": "2px",
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "20px",
      "xxl": "24px",
      "xxxl": "32px",
      "huge": "40px",
      "giant": "48px"
    },
    "radius": {
      "xs": "4px",
      "sm": "8px",
      "input": "10px",
      "button": "10px",
      "badge": "11px",
      "md": "12px",
      "card": "13px",
      "hero": "14px",
      "lg": "16px",
      "xl": "20px",
      "sheet": "24px",
      "full": "9999px"
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', monospace"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "fontWeight": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700",
        "extrabold": "800"
      },
      "lineHeight": {
        "tight": "1.25",
        "normal": "1.5",
        "relaxed": "1.75"
      }
    }
  },
  "semantic": {
    "color": {
      "brand": {
        "primary": "{primitive.color.navy.600}",
        "primaryLight": "{primitive.color.navy.500}",
        "primaryTint": "{primitive.color.navy.50}",
        "secondary": "{primitive.color.teal.600}",
        "secondaryTint": "{primitive.color.teal.50}",
        "tertiary": "{primitive.color.violet.500}",
        "tertiaryTint": "{primitive.color.violet.50}",
        "accent": "{primitive.color.gold.500}",
        "accentTint": "{primitive.color.gold.50}"
      },
      "surface": {
        "background": "#F5F6F8",
        "card": "#FFFFFF",
        "cardHover": "#FAFAFC",
        "overlay": "rgba(2, 6, 23, 0.6)",
        "sidebarDark": "{primitive.color.slate.950}",
        "sidebarBorder": "{primitive.color.slate.800}"
      },
      "text": {
        "primary": "#1A1D21",
        "secondary": "#5B6169",
        "muted": "#9AA1A9",
        "inverse": "#FFFFFF",
        "brand": "{primitive.color.navy.600}"
      },
      "border": {
        "default": "#E6E8EC",
        "divider": "#EEF0F3",
        "focus": "{primitive.color.navy.500}",
        "card": "{primitive.color.slate.100}"
      },
      "status": {
        "success": {
          "text": "#1E8E5A",
          "bg": "#E4F3F1",
          "border": "#A7F3D0"
        },
        "warning": {
          "text": "#A6790A",
          "bg": "#FBF1DF",
          "border": "#EDC87D"
        },
        "error": {
          "text": "#C13F3F",
          "bg": "#FDE8E8",
          "border": "#FECDD3"
        },
        "info": {
          "text": "#1B3A6B",
          "bg": "#EAF0F9",
          "border": "#ABC4E9"
        },
        "neutral": {
          "text": "#55606B",
          "bg": "#EEF0F2",
          "border": "#CBD5E1"
        }
      },
      "roles": {
        "teacher": {
          "primary": "#1B3A6B",
          "bg": "#EAF0F9"
        },
        "hod": {
          "primary": "#6C4FCE",
          "bg": "#EFEBFC"
        },
        "principal": {
          "primary": "#A6790A",
          "bg": "#FBF1DF"
        },
        "governance": {
          "primary": "#0E8074",
          "bg": "#E4F3F1"
        },
        "manager": {
          "primary": "#475569",
          "bg": "#F1F5F9"
        },
        "staff": {
          "primary": "#334155",
          "bg": "#F8FAFC"
        }
      }
    },
    "interaction": {
      "minTouchTarget": "48px",
      "focusRingWidth": "2px",
      "transitionDuration": "200ms",
      "transitionTiming": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  }
}
