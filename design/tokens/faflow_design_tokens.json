      "xl": "20px",
      "xxl": "24px",
      "xxxl": "32px",
      "huge": "40px",
      "giant": "48px"
    },
    "radius": {
      "xs": "4px",
      "sm": "8px",
      "input": "10px",
      "button": "10px",
      "badge": "11px",
      "md": "12px",
      "card": "14px",
      "hero": "16px",
      "lg": "16px",
      "xl": "20px",
      "sheet": "24px",
      "full": "9999px"
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', monospace"
      },
      "fontSize": {
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem"
      },
      "fontWeight": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700",
        "extrabold": "800"
      },
      "lineHeight": {
        "tight": "1.25",
        "normal": "1.5",
        "relaxed": "1.75"
      }
    }
  },
  "semantic": {
    "color": {
      "brand": {
        "primary": "{primitive.color.navy.600}",
        "primaryLight": "{primitive.color.navy.500}",
        "primaryTint": "{primitive.color.navy.50}",
        "secondary": "{primitive.color.teal.600}",
        "secondaryTint": "{primitive.color.teal.50}",
        "tertiary": "{primitive.color.violet.500}",
        "tertiaryTint": "{primitive.color.violet.50}",
        "accent": "{primitive.color.gold.600}",
        "accentTint": "{primitive.color.gold.50}"
      },
      "surface": {
        "background": "#F5F6F8",
        "card": "#FFFFFF",
        "cardHover": "#F9FAFC",
        "overlay": "rgba(15, 23, 42, 0.5)",
        "sidebar": "#FFFFFF",
        "sidebarBorder": "#E6E8EC",
        "sidebarActive": "{primitive.color.navy.50}",
        "sidebarActiveText": "{primitive.color.navy.600}"
      },
      "text": {
        "primary": "#1A1D21",
        "secondary": "#5B6169",
        "muted": "#667085",
        "inverse": "#FFFFFF",
        "brand": "{primitive.color.navy.600}"
      },
      "border": {
        "default": "#E6E8EC",
        "divider": "#EEF0F3",
        "control": "#828C99",
        "focus": "{primitive.color.navy.600}",
        "card": "#E6E8EC"
      },
      "status": {
        "success": {
          "text": "#166B45",
          "bg": "#ECFDF5",
          "border": "#A7F3D0"
        },
        "warning": {
          "text": "#7A5806",
          "bg": "#FBF1DF",
          "border": "#EDC87D"
        },
        "error": {
          "text": "#B02A2A",
          "bg": "#FFF1F2",
          "border": "#FECDD3"
        },
        "info": {
          "text": "#1B3A6B",
          "bg": "#EAF0F9",
          "border": "#ABC4E9"
        },
        "neutral": {
          "text": "#475569",
          "bg": "#F1F5F9",
          "border": "#CBD5E1"
        }
      },
      "roles": {
        "teacher": {
          "primary": "#1B3A6B",
          "bg": "#EAF0F9",
          "border": "#ABC4E9"
        },
        "hod": {
          "primary": "#6C4FCE",
          "bg": "#EFEBFC",
          "border": "#BFAFF5"
        },
        "principal": {
          "primary": "#7A5806",
          "bg": "#FBF1DF",
          "border": "#EDC87D"
        },
        "governance": {
          "primary": "#0B665D",
          "bg": "#E4F3F1",
          "border": "#94D1C9"
        },
        "manager": {
          "primary": "#334155",
          "bg": "#F1F5F9",
          "border": "#CBD5E1"
        },
        "staff": {
          "primary": "#1B3A6B",
          "bg": "#EAF0F9",
          "border": "#ABC4E9"
        }
      },
      "disabled": {
        "text": "#94A3B8",
        "bg": "#F1F5F9",
        "border": "#E2E8F0"
      },
      "focus": {
        "ring": "{primitive.color.navy.600}",
        "ringOffset": "#FFFFFF"
      },
      "skeleton": {
        "base": "#E2E8F0",
        "highlight": "#F1F5F9"
      },
      "tooltip": {
        "bg": "#0F172A",
        "text": "#FFFFFF",
        "border": "#334155"
      },
      "charts": [
        "#1B3A6B",
        "#0E8074",
        "#6C4FCE",
        "#7A5806",
        "#2563EB",
        "#E05638"
      ]
    },
    "elevation": {
      "flat": "none",
      "sm": "0 1px 2px 0 rgba(16, 24, 40, 0.05)",
      "card": "0 1px 3px 0 rgba(16, 24, 40, 0.06), 0 1px 2px -1px rgba(16, 24, 40, 0.04)",
      "cardHover": "0 8px 20px -4px rgba(27, 58, 107, 0.08), 0 4px 6px -2px rgba(27, 58, 107, 0.04)",
      "raised": "0 4px 8px -2px rgba(16, 24, 40, 0.08), 0 2px 4px -2px rgba(16, 24, 40, 0.04)",
      "dialog": "0 20px 25px -5px rgba(16, 24, 40, 0.1), 0 8px 10px -6px rgba(16, 24, 40, 0.08)",
      "sheet": "0 -8px 24px -4px rgba(16, 24, 40, 0.12)"
    },
    "interaction": {
      "minTouchTarget": "48px",
      "focusRingWidth": "2px",
      "transitionDuration": "200ms",
      "transitionTiming": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  }
}
