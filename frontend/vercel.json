{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://faflow-android-common.onrender.com/api/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://faflow-android-common.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
